# Pharmacy Management System — Environment Configuration Reference
# Copy this file to `.env` and customize for your deployment.
# Existing `.env` files are ignored by git; secrets must be overridden here.
# Never deploy with the application's built-in default secrets.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (relative to backend/):  sqlite:///./pharma_db.sqlite
# SQLite (absolute, Windows):     sqlite:///C:/Users/you/pharma_db.sqlite
DATABASE_URL=sqlite:///./pharma_db.sqlite

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a secure random key:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, the app falls back to an insecure default and logs a CRITICAL warning.
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_STRING

# JWT signing algorithm. Only change if you have a reason to.
ALGORITHM=HS256

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. A credential-carrying request
# must come from one of these origins. Defaults match Next.js dev + Tauri.
# In production, set this to your actual deployed origin(s) only.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://tauri.localhost,https://tauri.localhost,tauri://localhost

# ── Business rules ────────────────────────────────────────────────────────────
# Days before expiry to raise low/expiry alerts.
EXPIRY_ALERT_DAYS=30